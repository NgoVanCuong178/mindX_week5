# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
ODOO_URL=https://nv-cuong.odoo.com
ODOO_DB=nv-cuong
ODOO_USERNAME=your-login-email@example.com
ODOO_API_KEY=paste-your-api-key-here

# Ngôn ngữ tên giai đoạn khi gọi API (khớp giao diện Odoo)
ODOO_LANG=vi_VN

# Chống xử lý trùng: sổ trạng thái từng bước + thời hạn claim (giây)
STATE_DB_PATH=logs/state.db
CLAIM_LEASE_SECONDS=600
